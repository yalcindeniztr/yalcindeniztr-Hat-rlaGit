<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_usta_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_usta_widget"
    android:padding="12dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_usta_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🤖 USTA • Asistan"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_usta_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🟢 Çevrimiçi"
            android:textColor="#10B981"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="6dp"
        android:background="#26334155" />

    <!-- Hero Microphone Button (Direct Voice Listen) -->
    <Button
        android:id="@+id/widget_btn_usta_mic"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_widget_btn_mic"
        android:text="🎙️ USTA'YI DİNLE (DOKUN &amp; KONUŞ)"
        android:textColor="#0A0F1D"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Bottom Quick Action Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/widget_btn_lesson_plan"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="@drawable/bg_widget_chip"
            android:text="📋 Ders Planı"
            android:textColor="#E2E8F0"
            android:textSize="10sp" />

        <Button
            android:id="@+id/widget_btn_park"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/bg_widget_chip"
            android:text="🚗 Park Yeri"
            android:textColor="#E2E8F0"
            android:textSize="10sp" />

        <Button
            android:id="@+id/widget_btn_news"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:background="@drawable/bg_widget_chip"
            android:text="📰 Manşetler"
            android:textColor="#E2E8F0"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
