<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_jarvis_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:foregroundGravity="center"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/widget_btn_jarvis_mic"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:background="@drawable/bg_widget_jarvis_3d"
        android:clickable="true"
        android:focusable="true"
        android:padding="6dp">

        <ImageView
            android:id="@+id/widget_jarvis_icon"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginBottom="2dp"
            android:src="@drawable/ic_jarvis_widget_icon"
            android:contentDescription="Jarvis AI Asistan" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="JARVIS"
            android:textColor="#00E5FF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:shadowColor="#FF000000"
            android:shadowDx="1.5"
            android:shadowDy="2.0"
            android:shadowRadius="2.5" />

    </LinearLayout>

</FrameLayout>
