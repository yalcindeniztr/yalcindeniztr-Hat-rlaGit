<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Glow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#4D00E5FF" />
        </shape>
    </item>

    <!-- Metallic Outer Bezel -->
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="135"
                android:endColor="#1E293B"
                android:centerColor="#334155"
                android:startColor="#0F172A" />
            <stroke
                android:width="2dp"
                android:color="#00E5FF" />
        </shape>
    </item>

    <!-- Core Dark Titanium Body -->
    <item
        android:bottom="5dp"
        android:left="5dp"
        android:right="5dp"
        android:top="5dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="90"
                android:endColor="#0F172A"
                android:centerColor="#1E293B"
                android:startColor="#020617" />
            <stroke
                android:width="1dp"
                android:color="#FFD700" />
        </shape>
    </item>
</layer-list>
