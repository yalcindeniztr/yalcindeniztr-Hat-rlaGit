<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer 3D Drop Shadow Ring -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#2A000000" />
            <size android:width="68dp" android:height="68dp" />
        </shape>
    </item>

    <!-- Outer Bevel Edge / Glow Ring -->
    <item android:bottom="3dp" android:right="3dp" android:left="2dp" android:top="2dp">
        <shape android:shape="oval">
            <solid android:color="#40FFFFFF" />
        </shape>
    </item>

    <!-- 3D Base Body: Vibrant Turquoise (#00F2FE) to Light Red / Coral (#FF6584) Gradient -->
    <item android:bottom="4dp" android:right="3dp" android:left="3dp" android:top="2dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#00F2FE"
                android:centerColor="#38BDF8"
                android:endColor="#FF6584" />
            <stroke
                android:width="2dp"
                android:color="#99FFFFFF" />
        </shape>
    </item>

    <!-- Top-Left Inner Convex Emboss Specular Highlight for 3D sphere look -->
    <item android:left="6dp" android:top="5dp" android:right="18dp" android:bottom="24dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="24dp"
                android:startColor="#B3FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
